# Copy this file to .env (same directory as the docker-compose files) and fill in
# real values. .env is git-ignored and excluded from the Docker build context.
# Never commit real secrets.

# --- Required by docker-compose.dev.yml -------------------------------------
# Jupyter Lab access token. There is intentionally no default.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(24))"
JUPYTER_TOKEN=

# --- Required by docker-compose.monitoring.yml ------------------------------
# Grafana admin password (user: admin). There is intentionally no default.
GF_SECURITY_ADMIN_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Host interface the dev ports (Jupyter 8888, TensorBoard 6006, 8097, 8265) and
# the monitoring ports (Grafana 3000, Prometheus 9090, Loki 3100, exporters
# 9100/9445, GPU page 8080) are published on. Default is 127.0.0.1 (this machine
# only); use an SSH tunnel for remote access. Setting 0.0.0.0 exposes services
# that have no authentication (TensorBoard, Prometheus, Loki, exporters).
# BIND_ADDRESS=127.0.0.1
# MONITORING_BIND_ADDRESS=127.0.0.1

# Cloud fine-tuning keys are read from the process environment, not from this
# file: export TOGETHER_API_KEY / OPENAI_API_KEY in your shell.

# scripts/update_duckdns.sh and scripts/remote_setup.sh read these from the
# .env file one directory above this repository (../.env):
# DUCKDNS_DOMAIN=yourname-deepdiscord
# DUCKDNS_TOKEN=your-token-here
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_KEY_PATH=
